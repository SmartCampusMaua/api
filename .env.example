# Org -> InfluxDB instance config (plus mqtt broker credentials, for other services) lives in
# infra.json (gitignored), not here. Copy infra.example.json to infra.json and fill in real
# tokens. See README.md for details.
#
# Optional overrides (uncomment to change from defaults):
# INFRA_CONFIG_FILE=infra.json
# INFRA_CONFIG_REFRESH_SEC=30

# Registry (devices/assets/sensors/bus routing) Postgres — points at a dedicated `iot`
# database + role (matching deploy/iot-postgres.yaml's naming) inside whatever Postgres instance
# this points at. Locally that's typically a dedicated database inside this host's existing
# shared `smartcampus-postgres` container (not a container this repo manages itself), kept
# separate from that instance's other databases.
DATABASE_URL=postgres://iot:iot@localhost:5432/iot

# SHA-256 hash (not the plaintext) of the bearer token required for /api/registry/v0.1/... writes.
# Generate a token + its hash with:
#   bun -e "const t = crypto.randomUUID().replace(/-/g,'') + crypto.randomUUID().replace(/-/g,''); console.log('token:', t); console.log('hash: ', require('crypto').createHash('sha256').update(t).digest('hex'))"
REGISTRY_WRITE_TOKEN_HASH=
